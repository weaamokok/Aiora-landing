---
// Web purchase is paused (no web billing yet), so this route is switched off:
// the leading underscore keeps Astro from building it. Drop the underscore to restore.
import View from '../../../views/SignIn.astro';
import { nonDefaultLocales, type Locale } from '../../../i18n/locales';

export function getStaticPaths() {
  return nonDefaultLocales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
---
<View locale={locale} />
