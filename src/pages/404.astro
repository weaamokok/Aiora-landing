---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { copy } from '../i18n';
import { locales, localeMeta, localePath } from '../i18n/locales';
const { t } = copy('en');
---
<!-- route="/" so the nav and footer language links go to each language's home:
     there is no /ar/404/ to switch to. The page is noindex either way. -->
<Base locale="en" route="/" title={`${t.notFound.title} · Aiora`} noindex>
  <section class="nf wrap">
    <span class="spark" aria-hidden="true"><Mark variant="glyph" size={64} /></span>
    <h1 class="display t-section">{t.notFound.title}</h1>
    <p class="t-lede">{t.notFound.body}</p>
    <a class="btn btn--primary" href="/">{t.notFound.home}</a>
    <ul class="langs">
      {locales.filter((l) => l !== 'en').map((l) => (
        <li><a href={localePath(l, '/')} lang={localeMeta[l].tag}>{copy(l).t.notFound.home}</a></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .nf {
    min-height: 90svh;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    gap: var(--s-4);
    padding-block: var(--s-8);
  }

  .spark {
    color: var(--lilac-deep);
  }

  @media (prefers-reduced-motion: no-preference) {
    .spark {
      animation: let-go 3.2s var(--ease-out) infinite;
    }
  }

  @keyframes let-go {
    0% {
      opacity: 1;
      scale: 1;
      filter: blur(0);
      translate: 0 0;
    }
    70%,
    100% {
      opacity: 0;
      scale: 1.6;
      filter: blur(8px);
      translate: 0 -30px;
    }
  }

  .t-lede {
    margin-inline: auto;
  }

  .langs {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 16px;
    margin-top: var(--s-4);
    font-size: var(--step--1);
  }

  .langs a {
    color: var(--ink-2);
  }
</style>
