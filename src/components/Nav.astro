---
import Mark from './Mark.astro';
import { copy } from '../i18n';
import { localeMeta, localePath, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  route: string;
  availableIn: readonly Locale[];
}
const { locale, route, availableIn } = Astro.props;
const { t } = copy(locale);
const home = localePath(locale, '/');
const links = [
  { href: `${home}#how`, label: t.nav.how },
  { href: localePath(locale, '/plus'), label: t.nav.plus, current: route.startsWith('/plus') },
  { href: localePath(locale, '/faq'), label: t.nav.faq, current: route === '/faq' },
];
---
<header class="topbar">
  <a class="brand glass" href={home} aria-label={t.nav.home}>
    <Mark size={34} />
    <span class="display brand-word" aria-hidden="true">Aiora</span>
  </a>

  <!-- Desktop: the app's floating nav pill, in glass — the one place this site uses it. -->
  <nav class="pill glass" aria-label="Main">
    {links.map((l) => (
      <a class="pill-link" href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
    ))}
    <span class="pill-sep" aria-hidden="true"></span>
    <button class="lang-btn" type="button" popovertarget="lang-menu" aria-label={t.nav.language}>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.7" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.2-2.4 3.4-5.4 3.4-9S14.2 5.4 12 3m0 18c-2.2-2.4-3.4-5.4-3.4-9S9.8 5.4 12 3M3.5 9h17M3.5 15h17" /></svg>
      <span class="lang-code">{locale.toUpperCase()}</span>
    </button>
    <a class="btn btn--primary pill-cta" href={`${home}#get`} data-store-link>{t.nav.getApp}</a>
  </nav>

  <div id="lang-menu" class="lang-menu" popover>
    <p class="visually-hidden">{t.nav.language}</p>
    <ul>
      {availableIn.map((l) => (
        <li>
          <a
            href={localePath(l, route)}
            hreflang={localeMeta[l].tag}
            lang={localeMeta[l].tag}
            dir={localeMeta[l].dir}
            aria-current={l === locale ? 'true' : undefined}
          >
            {localeMeta[l].name}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<!-- Mobile: the same pill, docked at the bottom where the thumb already is — like the app's tab bar. -->
<nav class="dock glass" aria-label="Main">
  {links.map((l) => (
    <a class="dock-link" href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
  ))}
  <a class="btn btn--primary dock-cta" href={`${home}#get`} data-store-link>{t.nav.getApp}</a>
</nav>

<style>
  .topbar {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-nav);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: max(var(--s-4), env(safe-area-inset-top)) var(--gutter) var(--s-3);
    pointer-events: none;
  }

  .topbar > * {
    pointer-events: auto;
  }

  /* The header is fixed and content scrolls under it, so the wordmark sits on
     the same floating glass as the nav pill rather than on whatever happens to
     be behind it. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 16px 6px 8px;
    border-radius: var(--r-pill);
    text-decoration: none;
  }

  .brand-word {
    font-size: 1.6rem;
    line-height: 1;
    /* The wordmark is Latin by construction in every locale, so the literal
       face is safe here even on Arabic and Russian pages. */
    font-family: 'Lilita One', system-ui, sans-serif;
    font-weight: 400;
    letter-spacing: 0;
  }

  /* ─── Glass (L2 floating) ─────────────────────────────────────────────── */
  .glass {
    background: rgb(255 255 255 / 0.66);
    -webkit-backdrop-filter: blur(22px) saturate(1.7);
    backdrop-filter: blur(22px) saturate(1.7);
    box-shadow:
      inset 0 0 0 0.5px rgb(255 255 255 / 0.9),
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      var(--shadow-floating);
    color: var(--ink);
    transition:
      background-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  /* Never stack light frost on a dark ground — the pill darkens with it. */
  :global(html[data-nav-tone='dark']) .glass,
  :global(html[data-nav-tone='teal']) .glass {
    background: rgb(34 38 43 / 0.62);
    color: var(--dusk-ink);
    box-shadow:
      inset 0 0 0 0.5px rgb(255 255 255 / 0.14),
      inset 0 1px 0 rgb(255 255 255 / 0.1),
      0 0 28px rgb(0 0 0 / 0.3);
  }

  @media (prefers-reduced-transparency: reduce) {
    .glass {
      background: #fff;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    :global(html[data-nav-tone='dark']) .glass,
    :global(html[data-nav-tone='teal']) .glass {
      background: var(--dusk-floating);
    }
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 6px;
    border-radius: var(--r-pill);
  }

  .pill-link,
  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 16px;
    border: 0;
    border-radius: var(--r-pill);
    background: transparent;
    color: inherit;
    font-size: 0.95rem;
    font-weight: 560;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out);
  }

  .pill-link:hover,
  .lang-btn:hover,
  .pill-link[aria-current='page'] {
    background: rgb(127 127 127 / 0.14);
  }

  .lang-code {
    font-size: 0.8rem;
    letter-spacing: 0.02em;
  }

  .pill-sep {
    width: 1px;
    height: 20px;
    margin-inline: 4px;
    background: currentColor;
    opacity: 0.18;
  }

  .pill-cta {
    min-height: 40px;
    margin-inline-start: 4px;
    padding: 0 18px;
    font-size: 0.95rem;
  }

  .lang-menu {
    inset: auto;
    position: fixed;
    top: 76px;
    inset-inline-end: var(--gutter);
    margin: 0;
    padding: 8px;
    border: 0;
    border-radius: var(--r-md);
    background: #fff;
    color: var(--ink);
    box-shadow: var(--shadow-modal);
    min-width: 200px;
  }

  .lang-menu ul {
    list-style: none;
    padding: 0;
  }

  .lang-menu a {
    display: block;
    padding: 10px 14px;
    border-radius: var(--r-sm);
    text-decoration: none;
    font-weight: 520;
  }

  .lang-menu a:hover {
    background: var(--surface);
  }

  .lang-menu a[aria-current='true'] {
    background: var(--ground);
    color: var(--lilac-text);
    font-weight: 650;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lang-menu:popover-open,
    .lang-menu--fallback.is-open {
      animation: menu-in var(--dur) var(--ease-settle);
    }
  }

  /* Only applied when the browser has no popover support (see lang-menu.ts). */
  .lang-menu--fallback {
    display: none;
  }

  .lang-menu--fallback.is-open {
    display: block;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }

  /* ─── Dock (mobile) ───────────────────────────────────────────────────── */
  .dock {
    display: none;
  }

  @media (max-width: 760px) {
    .pill {
      display: contents;
    }

    .pill-link,
    .pill-sep,
    .pill-cta {
      display: none;
    }

    .brand {
      padding: 6px 14px 6px 8px;
    }

    .brand-word {
      font-size: 1.35rem;
    }

    .lang-btn {
      background: rgb(255 255 255 / 0.66);
      -webkit-backdrop-filter: blur(22px) saturate(1.7);
      backdrop-filter: blur(22px) saturate(1.7);
      box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.9), var(--shadow-floating);
      color: var(--ink);
    }

    :global(html[data-nav-tone='dark']) .lang-btn,
    :global(html[data-nav-tone='teal']) .lang-btn {
      background: rgb(34 38 43 / 0.62);
      color: var(--dusk-ink);
    }

    .lang-menu {
      top: 70px;
    }

    .dock {
      position: fixed;
      z-index: var(--z-nav);
      inset-inline: var(--s-3);
      bottom: max(var(--s-3), env(safe-area-inset-bottom));
      display: flex;
      align-items: center;
      gap: 2px;
      padding: 6px;
      border-radius: var(--r-pill);
    }

    .dock-link {
      flex: 1 1 auto;
      display: grid;
      place-items: center;
      min-height: 44px;
      padding: 0 6px;
      border-radius: var(--r-pill);
      text-decoration: none;
      font-size: 0.86rem;
      font-weight: 560;
      white-space: nowrap;
    }

    .dock-link[aria-current='page'] {
      background: rgb(127 127 127 / 0.14);
    }

    .dock-cta {
      flex: none;
      min-height: 44px;
      padding: 0 14px;
      font-size: 0.9rem;
    }

    :global(body) {
      padding-bottom: calc(76px + env(safe-area-inset-bottom));
    }
  }
</style>
