---
// Native <details>: keyboard, screen reader and find-in-page all work without
// a line of script. The open/close height animates where the browser supports
// `interpolate-size`, and simply snaps elsewhere.
interface Props {
  items: readonly { q: string; a: string }[];
  tone?: 'light' | 'dark';
  /** Only one open at a time (shared name) — off for the long FAQ page. */
  exclusive?: string;
}
const { items, tone = 'light', exclusive } = Astro.props;
---
<div class:list={['faq', `faq--${tone}`]}>
  {items.map((item) => (
    <details class="qa" name={exclusive}>
      <summary>
        <span>{item.q}</span>
        <span class="chev" aria-hidden="true"></span>
      </summary>
      <div class="answer"><p>{item.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq {
    display: grid;
  }

  .qa {
    border-bottom: 1px solid rgb(28 43 47 / 0.12);
    interpolate-size: allow-keywords;
  }

  .faq--dark .qa {
    border-color: rgb(255 255 255 / 0.1);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 48px;
    padding-block: var(--s-4);
    font-size: var(--step-1);
    font-weight: 650;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .chev {
    flex: none;
    position: relative;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgb(127 127 127 / 0.14);
  }

  .chev::before,
  .chev::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    translate: -50% -50%;
    transition: rotate var(--dur) var(--ease-settle);
  }

  .chev::after {
    rotate: 90deg;
  }

  .qa[open] .chev::after {
    rotate: 0deg;
  }

  .answer {
    padding-bottom: var(--s-5);
    max-width: var(--measure);
    color: var(--ink-2);
  }

  .faq--dark .answer {
    color: var(--dusk-ink-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .qa::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size var(--dur) var(--ease-settle),
        content-visibility var(--dur) allow-discrete;
    }

    .qa[open]::details-content {
      block-size: auto;
    }
  }
</style>
