---
import { copy } from '../i18n';
import { localeMeta, STORE, type Locale } from '../i18n/locales';

interface Props {
  locale: Locale;
  /** Dark grounds get a hairline so the black badges don't sink into them. */
  onDark?: boolean;
  class?: string;
}
const { locale, onDark = false, class: className } = Astro.props;
const { t } = copy(locale);
const meta = localeMeta[locale];
---
<div class:list={['badges', className, { 'badges--dark': onDark }]}>
  <a class="badge badge--apple" href={STORE.appStore} rel="noopener" data-store="ios">
    <img src={`/badges/appstore-${meta.appStoreBadge}.svg`} alt={t.store.appStore} width="120" height="40" loading="lazy" decoding="async" />
  </a>
  <a class="badge badge--play" href={STORE.googlePlay} rel="noopener" data-store="android">
    <img src={`/badges/play-${meta.playBadge}.png`} alt={t.store.googlePlay} width="564" height="168" loading="lazy" decoding="async" />
  </a>
</div>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .badge {
    display: block;
    border-radius: 10px;
    transition: transform var(--dur-fast) var(--ease-settle);
  }

  .badge:active {
    transform: scale(0.97);
  }

  /* Apple's badge is drawn at 120×40 with its own rounded rect. */
  .badge--apple img {
    height: 52px;
    width: auto;
  }

  /* Google's PNGs are trimmed to the badge edge at sync time, so both badges
     share one height. */
  .badge--play img {
    height: 52px;
    width: auto;
  }

  .badges--dark .badge--apple,
  .badges--dark .badge--play {
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.28);
  }

  /* On a phone, lead with the store that phone can actually use. */
  :global(html[data-platform='android']) .badge--play {
    order: -1;
  }
</style>
