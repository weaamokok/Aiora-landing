---
import Icon from '../Icon.astro';
import Mark from '../Mark.astro';
import { copy } from '../../i18n';
import type { Locale } from '../../i18n/locales';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t, app } = copy(locale);

const bins = [
  { key: 'today', label: t.sort.bins.today, icon: 'check' },
  { key: 'shopping', label: t.sort.bins.shopping, icon: 'bag' },
  { key: 'goals', label: t.sort.bins.goals, icon: 'target' },
  { key: 'kept', label: t.sort.bins.kept, icon: 'bulb' },
] as const;

// Where each thought sits before it's sorted: a loose pile in the middle of the
// stage, in % of the stage box, with a little tilt.
const piles = [
  { x: 6, y: 26, r: -4 },
  { x: 50, y: 18, r: 3 },
  { x: 12, y: 60, r: 2 },
  { x: 50, y: 54, r: -3 },
  { x: 26, y: 40, r: 5 },
];
const items = t.sort.items.map((it, i) => ({ ...it, ...piles[i], index: i }));
const release = items.find((i) => i.to === 'release');
---
<section class="sort" id="how" data-tone="light" data-sort aria-labelledby="sort-title">
  <div class="sort-track">
    <div class="sort-sticky wrap">
      <div class="sort-copy">
        <h2 id="sort-title" class="display t-section">{t.sort.title}</h2>
        <p class="t-lede sort-body">{t.sort.body}</p>
        <ol class="steps">
          {t.sort.steps.map((s, i) => (
            <li class="step" data-step={i}>
              <span class="step-dot" aria-hidden="true"></span>
              <span>
                <strong>{s.title}</strong>
                <span class="step-body">{s.body}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>

      <div class="stage" data-stage aria-hidden="true">
        {bins.map((b) => (
          <div class={`bin bin--${b.key}`}>
            <p class="bin-head"><Icon name={b.icon} size={16} />{b.label}</p>
            <ul class="bin-slot">
              {items
                .filter((it) => it.to === b.key)
                .map((it) => (
                  <li class="note" data-item={it.index} style={`--px:${it.x};--py:${it.y};--pr:${it.r}deg`}>
                    {it.text}
                  </li>
                ))}
              {b.key === 'kept' && (
                <li class="note note--ghost">{app.kept}</li>
              )}
            </ul>
          </div>
        ))}
        {release && (
          <div class="note note--release" data-item={release.index} style={`--px:${release.x};--py:${release.y};--pr:${release.r}deg`}>
            <span class="release-text">{release.text}</span>
            <span class="release-label">{app.letGo}</span>
            <span class="release-spark"><Mark variant="glyph" size={36} /></span>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/sort-scroll';
</script>

<style>
  .sort {
    background: var(--surface);
  }

  /* The track is what you scroll through; the stage stays put inside it. */
  .sort-track {
    height: 300vh;
  }

  .sort-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: var(--s-7);
    padding-block: 88px var(--s-6);
  }

  .sort-body {
    margin-top: var(--s-4);
  }

  .steps {
    list-style: none;
    padding: 0;
    margin-top: var(--s-6);
    display: grid;
    gap: var(--s-4);
  }

  /* Steps ahead of you are *quieter*, not faded: dimming text far enough to
     read as "not yet" also dims it below the contrast floor, and these are
     real sentences someone may be reading. The current step is marked by its
     dot and its colour instead. */
  .step {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: var(--s-3);
    transition: color var(--dur) var(--ease-out);
  }

  .step strong {
    display: block;
    font-weight: 650;
  }

  .step-body {
    display: block;
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .step-dot {
    width: 10px;
    height: 10px;
    margin-top: 0.5em;
    border-radius: 50%;
    background: rgb(28 43 47 / 0.25);
    transition:
      background-color var(--dur) var(--ease-out),
      scale var(--dur) var(--ease-settle);
  }

  .step.is-active strong {
    color: var(--lilac-text);
  }

  .step.is-active .step-dot {
    background: var(--lilac-deep);
    scale: 1.3;
  }

  .step.is-done .step-dot {
    background: var(--primary);
  }

  /* ─── Stage ───────────────────────────────────────────────────────────── */
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
    align-content: center;
    min-height: min(560px, 70svh);
  }

  .bin {
    padding: var(--s-4);
    border-radius: var(--r-lg);
    background: #fff;
    box-shadow: var(--shadow-raised);
    min-height: 150px;
  }

  .bin--today {
    background: #fff;
  }
  .bin--shopping {
    background: #fff6ea;
  }
  .bin--goals {
    background: #e3ece9;
  }
  .bin--kept {
    background: #ebe6f3;
  }

  .bin-head {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: var(--step--1);
    font-weight: 650;
    color: rgb(28 43 47 / 0.7);
  }

  .bin-slot {
    list-style: none;
    padding: 0;
    margin-top: var(--s-3);
    display: grid;
    gap: 8px;
  }

  .note {
    /* Set by the scroll script: 0 at rest, 1 at the top of a note's arc. It
       drives elevation here so the shadow rises with the note instead of
       staying flat while it travels. */
    --lift: 0;
    padding: 10px 14px;
    border-radius: 12px;
    background: #fff;
    box-shadow:
      0 calc(1px + var(--lift) * 3px) calc(2px + var(--lift) * 5px) rgb(0 0 0 / 0.06),
      0 calc(6px + var(--lift) * 16px) calc(18px + var(--lift) * 20px) -8px
        rgb(28 43 47 / calc(0.25 + var(--lift) * 0.1));
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
    will-change: transform;
  }

  .note--ghost {
    background: transparent;
    box-shadow: inset 0 0 0 1px rgb(28 43 47 / 0.12);
    color: rgb(28 43 47 / 0.7);
    font-weight: 500;
    font-size: var(--step--1);
  }

  /* The thought that gets let go. It lives on the stage itself, not in a bin. */
  .note--release {
    position: absolute;
    inset-inline-start: calc(var(--px) * 1%);
    top: calc(var(--py) * 1%);
    max-width: 60%;
    rotate: var(--pr);
    display: grid;
    gap: 4px;
  }

  .release-label {
    color: var(--lilac-text);
    font-size: var(--step--1);
    font-weight: 650;
  }

  .release-spark {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--lilac-deep);
    opacity: 0;
  }

  @media (max-width: 900px) {
    .sort-track {
      height: 260vh;
    }

    .sort-sticky {
      grid-template-columns: 1fr;
      align-content: start;
      gap: var(--s-4);
      padding-block: 76px 96px;
    }

    .sort-body {
      display: none;
    }

    .steps {
      margin-top: var(--s-3);
    }

    /* Only the current step fits on a phone. */
    .sort[data-live] .step:not(.is-active) {
      display: none;
    }

    .stage {
      gap: 10px;
      min-height: 0;
    }

    .bin {
      padding: 12px;
      min-height: 120px;
      border-radius: var(--r-md);
    }

    .note {
      padding: 8px 10px;
      font-size: 0.88rem;
    }
  }

  /* No sticky choreography for reduced motion or without JS: a readable grid. */
  @media (prefers-reduced-motion: reduce) {
    .sort-track {
      height: auto;
    }
    .sort-sticky {
      position: static;
      height: auto;
      padding-block: var(--s-8);
    }
  }
</style>
