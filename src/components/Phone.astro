---
// A device frame whose inside scales as one unit. Everything within `.screen`
// is sized in `em`, and the screen's font-size is a fraction of its own width
// (container query units), so the app UI keeps its proportions from a 260px
// phone on mobile to a 380px one on desktop — like a screenshot, but real text
// that localizes, animates and stays sharp.
interface Props {
  class?: string;
  label?: string;
  time?: string;
  tone?: 'light' | 'dark';
}
const { class: className, label, time = '9:41', tone = 'light' } = Astro.props;
---
<div class:list={['phone', className, `phone--${tone}`]} role={label ? 'img' : undefined} aria-label={label}>
  <div class="screen" aria-hidden={label ? 'true' : undefined}>
    <div class="status">
      <span class="status-time">{time}</span>
      <span class="island"></span>
      <span class="status-icons">
        <svg viewBox="0 0 18 12" width="1.15em" aria-hidden="true"><path fill="currentColor" d="M1 8h2.5v4H1zM5.5 6H8v6H5.5zM10 3.5h2.5V12H10zM14.5 1H17v11h-2.5z" /></svg>
        <svg viewBox="0 0 26 12" width="1.7em" aria-hidden="true"><rect x="0.5" y="0.5" width="22" height="11" rx="3.5" fill="none" stroke="currentColor" opacity=".4" /><rect x="2" y="2" width="17" height="8" rx="2.2" fill="currentColor" /><path d="M24 4v4c.8-.3 1.3-1 1.3-2s-.5-1.7-1.3-2Z" fill="currentColor" opacity=".4" /></svg>
      </span>
    </div>
    <slot />
  </div>
</div>

<style>
  .phone {
    --bezel: #0e1113;
    container-type: inline-size;
    position: relative;
    aspect-ratio: 390 / 820;
    width: 100%;
    padding: 3.2%;
    border-radius: 15% / 7.2%;
    background: var(--bezel);
    box-shadow:
      inset 0 0 0 1.5px #3a3f44,
      0 40px 80px -30px rgb(28 43 47 / 0.45),
      0 18px 36px -18px rgb(28 43 47 / 0.3);
  }

  .screen {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: 12.4% / 5.8%;
    background: var(--surface);
    color: var(--ink);
    font-family: 'Roboto Flex Variable', system-ui, sans-serif;
    /* 26 "em" across the screen ≈ a 390pt iPhone at 15pt body. The container
       is the phone, and the screen is its width less the 3.2% bezel each side. */
    font-size: calc(93.6cqw / 26);
    line-height: 1.3;
    isolation: isolate;
  }

  .phone--dark .screen {
    background: #000;
    color: #fff;
  }

  .status {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.6em;
    padding: 0 1.9em;
    font-size: 0.95em;
    font-weight: 650;
  }

  .island {
    position: absolute;
    left: 50%;
    top: 0.75em;
    width: 7.4em;
    height: 2.15em;
    translate: -50% 0;
    border-radius: 999px;
    background: #000;
  }

  .status-icons {
    display: flex;
    align-items: center;
    gap: 0.35em;
  }

  /* Arabic/RTL pages still show a phone in the app's own direction for that
     locale — the parent `dir` flows in, so the UI mirrors like the real app. */
</style>
