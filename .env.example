# Site analytics. Leave PROVIDER unset (or "none") and nothing is loaded or sent.
# Both supported providers are cookieless, which is what keeps this site free of
# a consent banner — see src/scripts/analytics.ts.
#
# Plausible (hosted or self-hosted):
#   PUBLIC_ANALYTICS_PROVIDER=plausible
#   PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
#   PUBLIC_ANALYTICS_DOMAIN=aioraspace.com
#
# Umami (self-hosted — it would run alongside the API on the existing server):
#   PUBLIC_ANALYTICS_PROVIDER=umami
#   PUBLIC_ANALYTICS_SRC=https://stats.aioraspace.com/script.js
#   PUBLIC_ANALYTICS_SITE_ID=00000000-0000-0000-0000-000000000000

PUBLIC_ANALYTICS_PROVIDER=none

# Web sign-in for /plus. Until these exist (AIO-60) the Apple and Google
# buttons are simply not rendered, and email sign-in is the only route.
# PUBLIC_GOOGLE_WEB_CLIENT_ID=
# PUBLIC_APPLE_SERVICES_ID=

# Overrides the API host; defaults to https://api.aioraspace.com
# PUBLIC_API_BASE=
